<%- include('../layout', { body: ` <div class="page-header"><h2>\u{1F3F7}\uFE0F Tipos de Inventario</h2><a href="/tipos-inventario/crear" class="btn btn-primario">+ Nuevo Tipo</a></div>${typeof mensaje !== 'undefined' && mensaje ? '<div class="alerta alerta-exito">\u2705 ' + mensaje + '</div>' : ''}${typeof error !== 'undefined' && error ? '<div class="alerta alerta-error">\u26D4 ' + error + '</div>' : ''}<div class="filtros-panel"><form method="GET" action="/tipos-inventario" class="filtros-grid"><div class="filtro-grupo"><label>\u{1F50D} Buscar</label><input type="text" name="busqueda" class="form-control" placeholder="Buscar tipos..." value="${filtros.busqueda}"></div><div class="filtro-grupo"><label>\u{1F4CA} Estado</label><select name="estado" class="form-control"><option value="">Todos</option><option value="Activo" ${filtros.estado === 'Activo' ? 'selected' : ''}>Activo</option><option value="Inactivo" ${filtros.estado === 'Inactivo' ? 'selected' : ''}>Inactivo</option></select></div><div class="filtro-acciones"><button type="submit" class="btn btn-primario">\u{1F50D} Filtrar</button><a href="/tipos-inventario" class="btn btn-secundario">\u{1F504} Limpiar</a></div></form></div><div class="card"><div class="card-body"><table class="tabla"><thead><tr><th>ID</th><th>Descripci\u00F3n</th><th>Cuenta Contable</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>${tipos.length === 0 ? '<tr><td colspan="5"><div class="vacio"><span class="vacio-icon">\u{1F4ED}</span><p>No se encontraron tipos de inventario.</p></div></td></tr>' : ''}${tipos.map(t => '<tr>' + '<td>' + t.id + '</td>' + '<td>' + t.descripcion + '</td>' + '<td>' + (t.cuenta_contable || '\u2014') + '</td>' + '<td><span class="badge badge-' + (t.estado || 'activo').toLowerCase() + '">' + t.estado + '</span></td>' + '<td><div class="acciones"><a href="/tipos-inventario/editar/' + t.id + '" class="btn btn-sm btn-secundario">\u270F\uFE0F</a><form method="POST" action="/tipos-inventario/eliminar/' + t.id + '" class="form-eliminar" onsubmit="return confirmarEliminar(this)"><button type="submit" class="btn btn-sm btn-peligro">\u{1F5D1}\uFE0F</button></form></div></td>' + '</tr>').join('')}</tbody></table></div></div>` }) %>