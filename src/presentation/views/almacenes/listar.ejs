<%- include('../layout', { body: ` <div class="page-header"><h2>\u{1F3ED} Almacenes</h2><a href="/almacenes/crear" class="btn btn-primario">+ Nuevo Almac\u00E9n</a></div>${typeof mensaje !== 'undefined' && mensaje ? '<div class="alerta alerta-exito">\u2705 ' + mensaje + '</div>' : ''}${typeof error !== 'undefined' && error ? '<div class="alerta alerta-error">\u26D4 ' + error + '</div>' : ''}<div class="filtros-panel"><form method="GET" action="/almacenes" class="filtros-grid"><div class="filtro-grupo"><label>\u{1F50D} Buscar</label><input type="text" name="busqueda" class="form-control" placeholder="Buscar almacenes..." value="${filtros.busqueda}"></div><div class="filtro-grupo"><label>\u{1F4CA} Estado</label><select name="estado" class="form-control"><option value="">Todos</option><option value="Activo" ${filtros.estado === 'Activo' ? 'selected' : ''}>Activo</option><option value="Inactivo" ${filtros.estado === 'Inactivo' ? 'selected' : ''}>Inactivo</option></select></div><div class="filtro-acciones"><button type="submit" class="btn btn-primario">\u{1F50D} Filtrar</button><a href="/almacenes" class="btn btn-secundario">\u{1F504} Limpiar</a></div></form></div><div class="card"><div class="card-body"><table class="tabla"><thead><tr><th>ID</th><th>Descripci\u00F3n</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>${almacenes.length === 0 ? '<tr><td colspan="4"><div class="vacio"><span class="vacio-icon">\u{1F4ED}</span><p>No se encontraron almacenes.</p></div></td></tr>' : ''}${almacenes.map(a => '<tr>' + '<td>' + a.id + '</td>' + '<td>' + a.descripcion + '</td>' + '<td><span class="badge badge-' + (a.estado || 'activo').toLowerCase() + '">' + a.estado + '</span></td>' + '<td><div class="acciones"><a href="/almacenes/editar/' + a.id + '" class="btn btn-sm btn-secundario">\u270F\uFE0F</a><form method="POST" action="/almacenes/eliminar/' + a.id + '" class="form-eliminar" onsubmit="return confirmarEliminar(this)"><button type="submit" class="btn btn-sm btn-peligro">\u{1F5D1}\uFE0F</button></form></div></td>' + '</tr>').join('')}</tbody></table></div></div>` }) %>