<%- include('../layout', { body: ` <div class="page-header"><h2>\u{1F4CB} Art\u00EDculos</h2><a href="/articulos/crear" class="btn btn-primario">+ Nuevo Art\u00EDculo</a></div>${typeof mensaje !== 'undefined' && mensaje ? '<div class="alerta alerta-exito">\u2705 ' + mensaje + '</div>' : ''}${typeof error !== 'undefined' && error ? '<div class="alerta alerta-error">\u26D4 ' + error + '</div>' : ''}<div class="filtros-panel"><form method="GET" action="/articulos" class="filtros-grid"><div class="filtro-grupo"><label>\u{1F50D} Buscar</label><input type="text" name="busqueda" class="form-control" placeholder="Buscar art\u00EDculos..." value="${filtros.busqueda}"></div><div class="filtro-grupo"><label>\u{1F3F7}\uFE0F Tipo</label><select name="tipo_inventario_id" class="form-control"><option value="">Todos los tipos</option>${tiposInventario.map(t => '<option value="' + t.id + '" ' + (String(filtros.tipo_inventario_id) === String(t.id) ? 'selected' : '') + '>' + t.descripcion + '</option>').join('')}</select></div><div class="filtro-grupo"><label>\u{1F4CA} Estado</label><select name="estado" class="form-control"><option value="">Todos</option><option value="Activo" ${filtros.estado === 'Activo' ? 'selected' : ''}>Activo</option><option value="Inactivo" ${filtros.estado === 'Inactivo' ? 'selected' : ''}>Inactivo</option></select></div><div class="filtro-acciones"><button type="submit" class="btn btn-primario">\u{1F50D} Filtrar</button><a href="/articulos" class="btn btn-secundario">\u{1F504} Limpiar</a></div></form></div><div class="card"><div class="card-body"><table class="tabla"><thead><tr><th>ID</th><th>Descripci\u00F3n</th><th>Tipo Inventario</th><th>Costo Unit.</th><th>Existencia</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>${articulos.length === 0 ? '<tr><td colspan="7"><div class="vacio"><span class="vacio-icon">\u{1F4ED}</span><p>No se encontraron art\u00EDculos.</p></div></td></tr>' : ''}${articulos.map(a => '<tr>' + '<td>' + a.id + '</td>' + '<td>' + a.descripcion + '</td>' + '<td>' + (a.tipo_inventario_descripcion || '\u2014') + '</td>' + '<td>$' + parseFloat(a.costo_unitario).toFixed(2) + '</td>' + '<td>' + parseFloat(a.existencia_total).toFixed(2) + '</td>' + '<td><span class="badge badge-' + (a.estado || 'activo').toLowerCase() + '">' + a.estado + '</span></td>' + '<td><div class="acciones"><a href="/articulos/editar/' + a.id + '" class="btn btn-sm btn-secundario">\u270F\uFE0F</a><form method="POST" action="/articulos/eliminar/' + a.id + '" class="form-eliminar" onsubmit="return confirmarEliminar(this)"><button type="submit" class="btn btn-sm btn-peligro">\u{1F5D1}\uFE0F</button></form></div></td>' + '</tr>').join('')}</tbody></table></div></div>` }) %>